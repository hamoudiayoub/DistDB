query IT rowsort
SELECT r.id, a.owner FROM ref r JOIN acct a ON a.id = r.acct_id
----
1 bob
2 cy

query IT rowsort
SELECT r.id, a.owner FROM ref r LEFT JOIN acct a ON a.id = r.acct_id WHERE r.id <= 3
----
1 bob
2 cy
3 NULL

query IT nosort
SELECT r.id, a.owner FROM ref r JOIN acct a ON a.id = r.acct_id WHERE r.id = 2
----
