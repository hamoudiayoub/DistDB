CREATE TABLE n (id INT PRIMARY KEY, v INT, s TEXT)

statement ok
INSERT INTO n VALUES (1, 10, 'a'), (2, NULL, 'b'), (3, 30, NULL), (4, NULL, NULL), (5, 20, 'a')

query I nosort
SELECT id FROM n WHERE v IS NULL ORDER BY id
----
2
4

query I nosort
SELECT id FROM n WHERE v > 15 ORDER BY id
----
3
5

query I nosort
SELECT id FROM n WHERE NOT (v > 15) ORDER BY id
----
1

query I nosort
SELECT id FROM n WHERE v <> 10 OR s = 'b' ORDER BY id
----
2
3
5

query IIII nosort
SELECT count(*), count(v), count(s), count(DISTINCT s) FROM n
----
5 3 3 2

query ITT nosort
SELECT sum(v), avg(v), max(s) FROM n
----
60 20.0000000000000000 b

