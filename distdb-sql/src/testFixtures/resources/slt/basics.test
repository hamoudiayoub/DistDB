statement ok
CREATE TABLE "Mixed Case" ("Id" INT PRIMARY KEY, "Value" TEXT)

statement ok
INSERT INTO "Mixed Case" VALUES (1, 'quoted')

query IT nosort
SELECT "Id", "Value" FROM "Mixed Case"
----
1 quoted

statement ok
DROP TABLE "Mixed Case"

statement error 42P01
SELECT * FROM "Mixed Case"

statement ok
DROP TABLE IF EXISTS "Mixed Case"

# A table without a primary key has a hidden row id.
statement ok
CREATE TABLE nokey (v TEXT)

statement ok
INSERT INTO nokey VALUES ('a'), ('b'), ('a')

query T rowsort
SELECT * FROM nokey
----
a
a
b

query I nosort
SELECT count(*) FROM nokey WHERE v = 'a'
----
2

# Comments and several statements in one string.
statement ok
INSERT INTO nokey VALUES ('c'); -- a comment
INSERT INTO nokey VALUES ('d') /* another */

query I nosort
SELECT count(*) FROM nokey
----
5
