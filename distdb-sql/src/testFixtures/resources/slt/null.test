# NULL and three-valued logic.

query TTTT nosort
SELECT NULL IS NULL, NULL IS NOT NULL, 1 = NULL, NULL = NULL
----
t f NULL NULL

query TTTT nosort
SELECT true AND NULL, false AND NULL, true OR NULL, false OR NULL
----
NULL f t NULL

query TT nosort
SELECT NOT NULL::boolean, (NULL::boolean) IS TRUE
----
NULL f

query TTTT nosort
SELECT 1 IN (1, NULL), 2 IN (1, NULL), 2 NOT IN (1, NULL), NULL IN (1, 2)
----
t NULL NULL NULL

query TTT nosort
SELECT NULL IS DISTINCT FROM NULL, 1 IS DISTINCT FROM NULL, 1 IS NOT DISTINCT FROM 1
----
f t t

query TTT nosort
SELECT 1 + NULL, 'a' || NULL, coalesce(NULL, NULL, 'z')
----
NULL NULL z

