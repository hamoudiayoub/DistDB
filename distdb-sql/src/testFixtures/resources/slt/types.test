statement ok
CREATE TABLE nums (id INT PRIMARY KEY, n NUMERIC(6, 2), f DOUBLE PRECISION, s VARCHAR(5))

statement ok
INSERT INTO nums VALUES (1, 1.005, 1.5, 'abc'), (2, 123.456, 0.1, 'abcde'), (3, 7, -0.25, '')

query ITTT nosort
SELECT id, n, f, s FROM nums ORDER BY id
----
1 1.01 1.5 abc
2 123.46 0.1 abcde
3 7.00 -0.25 (empty)

query TTT nosort
SELECT sum(n), avg(n), sum(f) FROM nums
----
131.47 43.8233333333333333 1.35

